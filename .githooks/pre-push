#!/bin/sh
# SwiftLint on the Swift files this push changes, the same error-level gate as
# CI's lint job, in seconds instead of a CI round trip.
# Enable once per clone: git config core.hooksPath .githooks

if ! command -v swiftlint >/dev/null 2>&1; then
    echo "pre-push: swiftlint not installed, skipping lint" >&2
    exit 0
fi

zero=0000000000000000000000000000000000000000
status=0
while read -r _ local_sha _ remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || continue
    else
        base=$remote_sha
    fi
    files=$(git diff --name-only --diff-filter=d "$base" "$local_sha" -- '*.swift')
    [ -z "$files" ] && continue
    # shellcheck disable=SC2086
    swiftlint lint --quiet $files || status=1
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: SwiftLint errors; fix them or push with --no-verify" >&2
fi
exit "$status"
